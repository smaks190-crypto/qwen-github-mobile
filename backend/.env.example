# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_API_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
# GitHub fine-grained PAT. Scope narrowly to selected repositories.
GITHUB_TOKEN=REPLACE_GITHUB_TOKEN
ALLOWED_REPOS=owner/repository,owner/another-repository
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# International QwenCloud standard API; follow Qwen Code auth docs for your provider.
QWENCLOUD_API_KEY=REPLACE_QWEN_API_KEY
OPENAI_BASE_URL=https://maas.qwencloudapi.com/compatible-mode/v1
OPENAI_MODEL=qwen3.8-max
# Worker image must be built locally. Requires Docker daemon.
QWEN_WORKER_IMAGE=qwen-github-worker:local
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
DB_PATH=./data/qwen_app.sqlite3
