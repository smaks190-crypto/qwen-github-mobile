{
  "expo": {
    "name": "Qwen GitHub Agent",
    "slug": "qwen-github-agent",
    "scheme": "qwendev",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.example.qwengithubagent",
      "permissions": [
        "com.termux.permission.RUN_COMMAND",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ]
  }
}
